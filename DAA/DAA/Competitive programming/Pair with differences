#include <stdio.h>

int main() {
    int n, k;
    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &k);

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[j] - a[i] == k ||
                a[i] - a[j] == k) {
                printf("1\n");
                return 0;
            }
        }
    }

    printf("0\n");

    return 0;
}
