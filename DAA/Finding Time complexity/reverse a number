#include <stdio.h>

void reverse(int n) {
    int rev = 0, rem;
    int c = 0;

    while (n != 0) {
        c++;

        rem = n % 10;
        c++;

        rev = rev * 10 + rem;
        c++;

        n /= 10;
        c++;
    }

    c += 3;
    printf("%d", c);
}

int main() {
    int n;
    scanf("%d", &n);

    reverse(n);

    return 0;
}
